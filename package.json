{
  "name": "road-riot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"npm:dev:client\" \"npm:dev:server\"",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts",
    "preview": "vite preview --config client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "start:server": "tsx server/src/index.ts",
    "test:load": "tsx scripts/loadNetwork.ts",
    "test:race": "tsx scripts/verifyRace.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/sdk": "0.18.6",
    "@colyseus/ws-transport": "0.18.4",
    "cors": "2.8.6",
    "express": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
